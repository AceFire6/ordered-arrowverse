package components

import "github.com/AceFire6/ordered-arrowverse/internal/frontend"

// SupportModal renders the Ko-Fi / PayPal support dialog.
templ SupportModal() {
	<dialog id="support" class="modal">
		<h2>Support Arrowverse</h2>
		<p>Hello! My name is Jethro. I created and have been working on the Arrowverse website since 2014.</p>
		<p>Your support allows me to keep working on and improving Arrowverse. Thank you for being a part of the Arrowverse community!</p>
		<p>If you'd like to support what I do here check out the project on GitHub or consider buying me a coffee on Ko-Fi or via PayPal!</p>
		<div class="modal-actions">
			<a href="https://ko-fi.com/B0B4XZIE" target="_blank">
				<img height="36"
					style="border:0;height:36px;"
					src="https://storage.ko-fi.com/cdn/kofi6.png?v=6"
					alt="Buy Me a Coffee at ko-fi.com"/>
			</a>
			<a class="btn btn-primary"
				href="https://paypal.me/AceFire6"
				target="_blank">Support me on PayPal</a>
		</div>
		<form method="dialog" class="modal-form">
			<button class="btn">Close</button>
		</form>
	</dialog>
}

// AcknowledgementsModal lists the show data sources the site draws from.
templ AcknowledgementsModal(showList []frontend.ShowData) {
	<dialog id="acknowledgements" class="modal">
		<h2>Acknowledgements</h2>
		<p>Content is drawn from:</p>
		<ul>
			for _, showData := range showList {
				for _, source := range showData.DataSources {
					<li>
						<a href={ source } target="_blank" rel="noopener">{ source }</a>
					</li>
				}
			}
		</ul>
		<form method="dialog">
			<button class="btn">Close</button>
		</form>
	</dialog>
}

// ContactModal renders the contact dialog.
templ ContactModal() {
	<dialog id="contact" class="modal">
		<h2>Contact</h2>
		<p>Made by Jethro Muller</p>
		<p>To contact me, <a href="mailto:arrowverse.info@gmail.com" target="_blank">email me</a>.</p>
		<p>Or, view my other projects on <a href="https://www.github.com/AceFire6" target="_blank">GitHub</a>.</p>
		<form method="dialog">
			<button class="btn">Close</button>
		</form>
	</dialog>
}
