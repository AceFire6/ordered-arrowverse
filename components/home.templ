package components

import (
	"strconv"
	"strings"

	"github.com/AceFire6/ordered-arrowverse/internal/frontend"
)

templ Home(reverser frontend.URLReverser, tableContent []frontend.TableRow, newestFirst bool, showList []frontend.ShowData, hiddenShowList []string, fromDate string, toDate string) {
	<main>
		<div class="container">
			<form hx-get={ reverser.Reverse("view:home") }
				hx-target="#episode-list"
				hx-swap="outerHTML"
				hx-select="#episode-list"
				hx-trigger="change from:input, change from:select, submit"
				hx-push-url="true"
				id="filter-form"
				class="filter-form">
				<input name="newest_first" value={ strconv.FormatBool(newestFirst) } title="Newest First" type="hidden"/>

				<div class="filter-row">
					<div class="filter-cell filter-cell-show">
						@SearchableMultiSelect("hide_show", showList, hiddenShowList, "Hide shows")
					</div>
					<div class="filter-cell">
						@NativeDateInput("from_date", "from-date", "From Date", fromDate)
					</div>
					<div class="filter-cell">
						@NativeDateInput("to_date", "to-date", "To Date", toDate)
					</div>
					<div class="filter-cell filter-cell-button">
						<button type="submit" id="filter-button" class="btn">Filter</button>
					</div>
				</div>
			</form>
		</div>
		<div class="container">
			<div class="row toolbar">
				<a href="#end" id="top">END</a>
				|
				<a href={ frontend.AddQueryParams(reverser.Reverse("view:home"), map[string]string{ "newest_first": strconv.FormatBool(!newestFirst) }) }>
					if newestFirst {
						OLDEST FIRST
					} else {
						NEWEST FIRST
					}
				</a>
				| <a href="#" id="no-color">DISABLE COLOR</a>
				| <a href="#" id="dark-mode">TOGGLE DARK MODE</a>
			</div>
		</div>
		<div class="container">
			@EpisodesTable(tableContent)
		</div>
		<div class="container">
			<div class="row back-to-top">
				<a href="#top" id="end">BACK TO TOP</a>
			</div>
		</div>
	</main>
}

// sliceContains is exposed as a package-local helper since templ can't
// inline a Contains call inside the conditional attribute rendering.
// Tests live in page_config_test.go (different package).
func sliceContains(haystack []string, needle string) bool {
	for _, item := range haystack {
		if item == needle {
			return true
		}
	}
	return false
}

// filterOption keeps the template-time search helper Go-native.
func filterOption(value, query string) bool {
	return strings.Contains(strings.ToLower(value), strings.ToLower(query))
}
