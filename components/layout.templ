package components

import "github.com/AceFire6/ordered-arrowverse/internal/frontend"

templ PageLayout(pageConfig *frontend.PageConfig) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Arrowverse episode order tracker. Never spoil a crossover episode again!"/>
			<link
				href={ pageConfig.Reverse("view:rss:recent-episodes") }
				rel="alternate"
				title="Recent Episodes"
				type="application/atom+xml"
			/>
			<link type="image/png" href={ pageConfig.Reverse("static:favicon") } rel="icon"/>
			<link rel="stylesheet" href={ pageConfig.Reverse("static:css:index") }/>
			<link rel="stylesheet" href={ pageConfig.Reverse("static:css:flatpickr") }/>
			@CsrfMeta(pageConfig.CSRFToken)
			<script src={ pageConfig.Reverse("static:js:htmx") } defer></script>
			<script src={ pageConfig.Reverse("static:js:alpine") } defer></script>
			<script src={ pageConfig.Reverse("static:js:flatpickr") } defer></script>
			<title>{ pageConfig.Title }</title>
		</head>
		<body class="">
			<a id="page-top"></a>
			@OldSiteBanner(pageConfig.UsingOldSite, pageConfig.OldSiteHost, pageConfig.NewSiteURL)
			@NavBar(pageConfig)
			<div class="container">
				@pageConfig.Contents
			</div>
			@Footer()
			@SupportModal()
			@AcknowledgementsModal(pageConfig.ShowList)
			@ContactModal()
			@Analytics(pageConfig.UsingOldSite)
			<nav class="fab-nav" aria-label="Page navigation">
				<a href="#page-top" id="back-to-top" class="fab" aria-label="Back to top" title="Back to top">
					<svg class="fab-icon-up" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M12 19V5M5 12l7-7 7 7"></path>
					</svg>
					<svg class="fab-icon-down" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M12 5v14M19 12l-7 7-7-7"></path>
					</svg>
					<span class="fab-label">Back to top</span>
				</a>
			</nav>
			<script>
					// Tiny dependency-free controller: cookie plumbing for
					// dark-mode + colour toggle, and a minimal modal opener.
					(function() {
						var COOKIES = (document.cookie || "").split(";");
						var settings = {};
						for (var i = 0; i < COOKIES.length; i++) {
							var parts = COOKIES[i].split("=");
							if (parts.length !== 2) continue;
							settings[parts[0].trim()] = parts[1];
						}

						function setCookie(name, value) {
							document.cookie = name + "=" + value + "; path=/; max-age=" + (60 * 60 * 24 * 365);
						}

						function readCookie(name, fallback) {
							var v = settings[name];
							return v === undefined ? fallback : v;
						}

						// Initial paint - dark mode honours stored value, falling
						// back to system preference when unset.
						var storedDark = settings["dark-mode"];
						var useDark = storedDark === "1" || (storedDark === undefined &&
							window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
						document.body.classList.toggle("dark-mode", useDark);

						// Initial paint - per-show row tinting.
						var colour = readCookie("colour", "1");
						var colourEnabled = colour !== "0";
						document.body.classList.toggle("no-color", !colourEnabled);

						// Toggle helper - keep aria-pressed, body class, cookie,
						// and accessible label in lockstep for one button.
						function applyToggle(button, pressed, pressedLabel, unpressedLabel) {
							button.setAttribute("aria-pressed", pressed ? "true" : "false");
							button.setAttribute("aria-label", pressed ? pressedLabel : unpressedLabel);
						}

						// Click handler - dark-mode toggle (navbar icon button).
						var darkButton = document.getElementById("dark-mode");
						if (darkButton) {
							applyToggle(darkButton, useDark, "Switch to light mode", "Switch to dark mode");
							darkButton.addEventListener("click", function(event) {
								event.preventDefault();
								var nextDark = !document.body.classList.contains("dark-mode");
								document.body.classList.toggle("dark-mode", nextDark);
								setCookie("dark-mode", nextDark ? "1" : "0");
								applyToggle(darkButton, nextDark, "Switch to light mode", "Switch to dark mode");
							});
						}

						// Click handler - colour toggle (navbar icon button).
						// Mirrors the dark-mode pattern: icon-button has no
						// text, so the accessible name in aria-label flips with
						// state, and aria-live="polite" announces the change.
						var colourButton = document.getElementById("no-color");
						if (colourButton) {
							applyToggle(colourButton, colourEnabled, "Disable row tinting", "Enable row tinting");
							colourButton.addEventListener("click", function(event) {
								event.preventDefault();
								document.body.classList.toggle("no-color");
								var isEnabled = !document.body.classList.contains("no-color");
								setCookie("colour", isEnabled ? "1" : "0");
								applyToggle(colourButton, isEnabled, "Disable row tinting", "Enable row tinting");
							});
						}

						// Morphing FAB - shows once the user has scrolled past
						// half a viewport, then reflects what the user most
						// likely wants next:
						//   - Top 25% of page    -> "Jump to bottom"
						//   - Bottom 25% of page -> "Back to top"
						//   - Middle 50%         -> last scroll direction
						// Direction is tracked from scrollY delta with a small
						// noise threshold so wheel jitter doesn't flip the FAB.
						var fab = document.getElementById("back-to-top");
						var fabLabel = fab ? fab.querySelector(".fab-label") : null;
						if (fab && fabLabel) {
							var currentMode = "";
							var prevScrollY = window.scrollY;
							var lastDirection = 1; // 1 = down, -1 = up
							var DIRECTION_MIN_DELTA = 5;

							function applyMode(mode) {
								if (mode === currentMode) return;
								currentMode = mode;
								if (mode === "") {
									fab.classList.remove("visible");
									return;
								}
								fab.classList.add("visible");
								if (mode === "bottom") {
									fab.classList.add("mode-bottom");
									fab.setAttribute("href", "#page-end");
									fab.setAttribute("aria-label", "Jump to bottom");
									fab.setAttribute("title", "Jump to bottom");
									fabLabel.textContent = "Jump to bottom";
								} else {
									fab.classList.remove("mode-bottom");
									fab.setAttribute("href", "#page-top");
									fab.setAttribute("aria-label", "Back to top");
									fab.setAttribute("title", "Back to top");
									fabLabel.textContent = "Back to top";
								}
							}

							function updateFab() {
								var docHeight = document.documentElement.scrollHeight;
								var viewHeight = window.innerHeight;
								var scrollMax = Math.max(1, docHeight - viewHeight);
								var currentY = window.scrollY;
								var delta = currentY - prevScrollY;
								prevScrollY = currentY;

								if (Math.abs(delta) >= DIRECTION_MIN_DELTA) {
									lastDirection = delta > 0 ? 1 : -1;
								}

								var showThreshold = viewHeight * 0.5;
								if (currentY <= showThreshold) {
									applyMode("");
									return;
								}

								var topZone = scrollMax * 0.25;
								var bottomZone = scrollMax * 0.75;
								var mode;
								if (currentY <= topZone) {
									mode = "bottom";
								} else if (currentY >= bottomZone) {
									mode = "top";
								} else {
									mode = lastDirection > 0 ? "bottom" : "top";
								}
								applyMode(mode);
							}

							window.addEventListener("scroll", updateFab, { passive: true });
							window.addEventListener("resize", updateFab, { passive: true });
							updateFab();
						}

						// Click handlers - modal opener.
						document.addEventListener("click", function(event) {
							var target = event.target.closest("[data-modal-open]");
							if (!target) return;
							var modal = document.getElementById(target.getAttribute("data-modal-open"));
							if (modal && typeof modal.showModal === "function") {
								event.preventDefault();
								modal.showModal();
							}
						});

						// htmx wiring - propagate the CSRF token (read from the
						// meta tag Echo's middleware seeded) into every outgoing
						// request as the X-CSRF-Token header.
						document.addEventListener("htmx:configRequest", function(event) {
							var meta = document.querySelector("meta[name=csrf-token]");
							if (meta) {
								event.detail.headers["X-CSRF-Token"] = meta.getAttribute("content");
							}
						});

						// Searchable multi-select - debounce-free filter that
						// hides options whose combined text doesn't contain
						// the search query.
						document.addEventListener("input", function(event) {
							var input = event.target;
							if (!input.classList || !input.classList.contains("multiselect-search")) {
								return;
							}
							var query = input.value.trim().toLowerCase();
							var items = input.parentElement.querySelectorAll(".multiselect-options li");
							for (var i = 0; i < items.length; i++) {
								var li = items[i];
								var text = li.textContent.toLowerCase();
								li.style.display = (query === "" || text.indexOf(query) >= 0) ? "" : "none";
							}
						});

						// Click-outside closes any open details/multiselect.
						document.addEventListener("click", function(event) {
							var open = document.querySelectorAll(".multiselect[open]");
							for (var i = 0; i < open.length; i++) {
								if (!open[i].contains(event.target)) {
									open[i].removeAttribute("open");
								}
							}
						});

						// Alpine component for the searchable multi-select popover.
						// Kept tiny so it can be inlined alongside the rest of the
						// dependency-free page controllers. Returns the reactive
						// scope used by the components/multiselect.templ template.
						window.multiselectPanel = function() {
							return {
								open: false,
								search: '',
								// Bump counter so x-text="summary()" re-evaluates
								// when a checkbox toggles. summary() reads this
								// counter to register a dependency on the
								// Alpine reactive graph (DOM queries alone are
								// not reactive).
								n: 0,
								summary: function() {
									// Touch the counter so x-text tracks it.
									this.n;
									var scope = this.$root;
									var checked = scope.querySelectorAll(
										'input[type=checkbox]:checked'
									);
									if (checked.length === 0) return 'All shows';
									var names = [];
									for (var i = 0; i < checked.length; i++) {
										var name = checked[i].closest('label').querySelector('.multiselect-name');
										if (name) names.push(name.textContent.trim());
									}
									return names.join(', ');
								},
								matches: function(name) {
									if (this.search === '') return true;
									return String(name).toLowerCase().indexOf(this.search.toLowerCase()) !== -1;
								},
								hasMatches: function() {
									var scope = this.$root;
									var items = scope.querySelectorAll('.multiselect-options > .multiselect-option');
									for (var i = 0; i < items.length; i++) {
										if (this.matches(items[i].dataset.showName)) {
											return true;
										}
									}
									return false;
								},
								clearAll: function() {
									var scope = this.$root;
									var boxes = scope.querySelectorAll('input[type=checkbox]');
									for (var i = 0; i < boxes.length; i++) {
										boxes[i].checked = false;
									}
									// htmx's hx-trigger='change from:input' filter
									// rejects events that don't originate from an
									// input element. We have to fire the simulated
									// change event on a checkbox (not the form) so
									// event.target is an input.
									if (boxes.length === 0) {
										this.$dispatch('multiselect:change');
										this.update();
										return;
									}
									if (window.htmx && typeof window.htmx.trigger === 'function') {
										window.htmx.trigger(boxes[0], 'change');
									} else {
										boxes[0].dispatchEvent(new Event('change', { bubbles: true }));
									}
									this.$dispatch('multiselect:change');
									this.update();
								},
								update: function() {
									// Bump the counter so summary() is re-evaluated
									// by Alpine's reactivity.
									this.n = this.n + 1;
								}
							};
						};
					})();

					// Flatpickr init - upgrades every .js-date-input to a
					// themed calendar popover. Reads initial value out of the
					// aria-controls sibling so existing server-rendered values
					// (e.g. "from_date=2020-01-01") carry over without a
					// second round-trip.
					function initFlatpickr() {
						if (typeof window.flatpickr === 'undefined') return;
						var inputs = document.querySelectorAll('.js-date-input');
						for (var i = 0; i < inputs.length; i++) {
							window.flatpickr(inputs[i], {
								dateFormat: 'Y-m-d',
								allowInput: true,
								disableMobile: true,
								theme: 'site',
							});
						}
					}
					if (document.readyState === 'loading') {
						document.addEventListener('DOMContentLoaded', initFlatpickr);
					} else {
						initFlatpickr();
					}
					// Re-run after htmx swaps so re-rendered inputs pick up
					// the picker again. Also re-evaluate the back-to-top FAB
					// since the page height may have changed.
					document.body.addEventListener('htmx:afterSwap', function() {
						initFlatpickr();
						updateFab();
					});
				</script>
		</body>
	</html>
}

templ Footer() {
	<footer class="site-footer container">
		<div class="row footer-buttons">
			<button type="button" class="btn btn-sm" data-modal-open="contact">Contact Me</button>
			<button type="button" class="btn btn-sm" data-modal-open="acknowledgements">Acknowledgements</button>
			<a href="/legal/cookie-policy" target="_blank">Cookie Policy</a>
			<a href="/legal/privacy-policy" target="_blank">Privacy Policy</a>
		</div>
	</footer>
}
