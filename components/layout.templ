package components

import "github.com/AceFire6/ordered-arrowverse/internal/frontend"

templ PageLayout(pageConfig *frontend.PageConfig) {
	<!DOCTYPE html>
		<html lang="en">
			<head>
				<meta charset="UTF-8"/>
				<meta name="viewport" content="width=device-width, initial-scale=1"/>
				<meta name="description" content="Arrowverse episode order tracker. Never spoil a crossover episode again!">
				<link href={ pageConfig.Reverse("view:rss:recent-episodes") }
					rel="alternate"
					title="Recent Episodes"
					type="application/atom+xml"/>
				<link type="image/png" href={ pageConfig.Reverse("static:favicon") } rel="icon">
				<link rel="stylesheet" href={ pageConfig.Reverse("static:css:index") }>
				@CsrfMeta(pageConfig.CSRFToken)
				<script src={ pageConfig.Reverse("static:js:htmx") } defer></script>
				<script src={ pageConfig.Reverse("static:js:alpine") } defer></script>
				<title>{ pageConfig.Title }</title>
			</head>
			<body class="">
				@OldSiteBanner(pageConfig.UsingOldSite, pageConfig.OldSiteHost, pageConfig.NewSiteURL)
				@NavBar(pageConfig)
				<div class="container">
					@pageConfig.Contents
				</div>
				@Footer()
				@SupportModal()
				@AcknowledgementsModal(pageConfig.ShowList)
				@ContactModal()
				@Analytics(pageConfig.UsingOldSite)
				<script>
					// Tiny dependency-free controller: cookie plumbing for
					// dark-mode + colour toggle, and a minimal modal opener.
					(function() {
						var COOKIES = (document.cookie || "").split(";");
						var settings = {};
						for (var i = 0; i < COOKIES.length; i++) {
							var parts = COOKIES[i].split("=");
							if (parts.length !== 2) continue;
							settings[parts[0].trim()] = parts[1];
						}

						function setCookie(name, value) {
							document.cookie = name + "=" + value + "; path=/; max-age=" + (60 * 60 * 24 * 365);
						}

						function readCookie(name, fallback) {
							var v = settings[name];
							return v === undefined ? fallback : v;
						}

						// Initial paint - dark mode honours stored value, falling
						// back to system preference when unset.
						var storedDark = settings["dark-mode"];
						var useDark = storedDark === "1" || (storedDark === undefined &&
							window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
						document.body.classList.toggle("dark-mode", useDark);

						// Initial paint - per-show row tinting.
						var colour = readCookie("colour", "1");
						document.body.classList.toggle("no-color", colour === "0");

						// Click handlers - dark-mode toggle.
						var darkButton = document.getElementById("dark-mode");
						if (darkButton) {
							darkButton.addEventListener("click", function(event) {
								event.preventDefault();
								var nextDark = !document.body.classList.contains("dark-mode");
								document.body.classList.toggle("dark-mode", nextDark);
								setCookie("dark-mode", nextDark ? "1" : "0");
								darkButton.textContent = nextDark ? "TOGGLE LIGHT MODE" : "TOGGLE DARK MODE";
							});
						}

						// Click handlers - colour toggle.
						var colourButton = document.getElementById("no-color");
						if (colourButton) {
							colourButton.addEventListener("click", function(event) {
								event.preventDefault();
								var nextColour = document.body.classList.contains("no-color");
								document.body.classList.toggle("no-color", !nextColour);
								setCookie("colour", nextColour ? "1" : "0");
								colourButton.textContent = nextColour ? "DISABLE COLOR" : "ENABLE COLOR";
							});
						}

						// Click handlers - modal opener.
						document.addEventListener("click", function(event) {
							var target = event.target.closest("[data-modal-open]");
							if (!target) return;
							var modal = document.getElementById(target.getAttribute("data-modal-open"));
							if (modal && typeof modal.showModal === "function") {
								event.preventDefault();
								modal.showModal();
							}
						});

						// htmx wiring - propagate the CSRF token (read from the
						// meta tag Echo's middleware seeded) into every outgoing
						// request as the X-CSRF-Token header.
						document.addEventListener("htmx:configRequest", function(event) {
							var meta = document.querySelector("meta[name=csrf-token]");
							if (meta) {
								event.detail.headers["X-CSRF-Token"] = meta.getAttribute("content");
							}
						});

						// Searchable multi-select - debounce-free filter that
						// hides options whose combined text doesn't contain
						// the search query.
						document.addEventListener("input", function(event) {
							var input = event.target;
							if (!input.classList || !input.classList.contains("multiselect-search")) {
								return;
							}
							var query = input.value.trim().toLowerCase();
							var items = input.parentElement.querySelectorAll(".multiselect-options li");
							for (var i = 0; i < items.length; i++) {
								var li = items[i];
								var text = li.textContent.toLowerCase();
								li.style.display = (query === "" || text.indexOf(query) >= 0) ? "" : "none";
							}
						});

						// Click-outside closes any open details/multiselect.
						document.addEventListener("click", function(event) {
							var open = document.querySelectorAll(".multiselect[open]");
							for (var i = 0; i < open.length; i++) {
								if (!open[i].contains(event.target)) {
									open[i].removeAttribute("open");
								}
							}
						});

						// Alpine component for the searchable multi-select popover.
						// Kept tiny so it can be inlined alongside the rest of the
						// dependency-free page controllers. Returns the reactive
						// scope used by the components/multiselect.templ template.
						window.multiselectPanel = function() {
							return {
								open: false,
								search: '',
								// Bump counter so x-text="summary()" re-evaluates
								// when a checkbox toggles. summary() reads this
								// counter to register a dependency on the
								// Alpine reactive graph (DOM queries alone are
								// not reactive).
								n: 0,
								summary: function() {
									// Touch the counter so x-text tracks it.
									this.n;
									var scope = this.$root;
									var checked = scope.querySelectorAll(
										'input[type=checkbox]:checked'
									);
									if (checked.length === 0) return 'All shows';
									if (checked.length === 1) {
										var label = checked[0].closest('label');
										var name = label ? label.querySelector('.multiselect-name') : null;
										return name ? name.textContent.trim() : '1 hidden';
									}
									return checked.length + ' hidden';
								},
								matches: function(name) {
									if (this.search === '') return true;
									return String(name).toLowerCase().indexOf(this.search.toLowerCase()) !== -1;
								},
								hasMatches: function() {
									var scope = this.$root;
									var items = scope.querySelectorAll('.multiselect-options > .multiselect-option');
									for (var i = 0; i < items.length; i++) {
										if (this.matches(items[i].dataset.showName)) {
											return true;
										}
									}
									return false;
								},
								clearAll: function() {
									var scope = this.$root;
									var boxes = scope.querySelectorAll('input[type=checkbox]');
									for (var i = 0; i < boxes.length; i++) {
										boxes[i].checked = false;
									}
									this.$dispatch('multiselect:change');
									this.update();
								},
								update: function() {
									// Bump the counter so summary() is re-evaluated
									// by Alpine's reactivity.
									this.n = this.n + 1;
								}
							};
						};
					})();
				</script>
			</body>
		</html>
}

templ Footer() {
	<footer class="site-footer container">
		<div class="row footer-buttons">
			<button type="button" data-modal-open="contact">Contact Me</button>
			<button type="button" data-modal-open="acknowledgements">Acknowledgements</button>
			<a href="/legal/cookie-policy" target="_blank">Cookie Policy</a>
			<a href="/legal/privacy-policy" target="_blank">Privacy Policy</a>
		</div>
	</footer>
}
