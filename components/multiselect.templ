package components

import "github.com/AceFire6/ordered-arrowverse/internal/frontend"

// SearchableMultiSelect renders a popover-style multi-select. Alpine.js
// (loaded once per page by layout.templ) handles the open/close state,
// the search filter, the trigger summary, and the click-outside / escape
// dismissals. The actual selection state lives on the checkboxes
// themselves so form submission keeps working without JavaScript.
templ SearchableMultiSelect(name string, showList []frontend.ShowData, selected []string, label string) {
	<div class="multiselect" x-data="multiselectPanel()" x-cloak>
		<button type="button" class="multiselect-trigger"
			@click="open = !open"
			:aria-expanded="open.toString()"
			aria-controls={ "multiselect-panel-" + name }>
			<span class="multiselect-label">{ label }</span>
			<span class="multiselect-summary" x-text="summary()"></span>
			<svg class="multiselect-chevron" :class="{ 'is-open': open }"
				xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
				<path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
			</svg>
		</button>

		<div class="multiselect-panel"
			id={ "multiselect-panel-" + name }
			x-show="open"
			x-transition.opacity.duration.150ms
			@click.outside="open = false"
			@keydown.escape.stop="open = false"
			role="dialog"
			aria-label={ label }>
			<input type="search"
				class="multiselect-search"
				placeholder="Search shows..."
				x-model="search"
				x-ref="search"
				aria-label={ "Search " + label }
				autocomplete="off"/>

			<ul class="multiselect-options" role="listbox" aria-multiselectable="true">
				for _, showData := range showList {
					<li class="multiselect-option"
						data-show-name={ showData.Name }
						x-show="matches($el.dataset.showName)">
						<label class="multiselect-option-label">
							<input type="checkbox"
								name={ name }
								value={ showData.Slug }
								if sliceContains(selected, showData.Slug) {
									checked
								}
								@change="$dispatch('multiselect:change'); update()"/>
							<span class="multiselect-name">{ showData.Name }</span>
							<svg class="multiselect-checkmark" aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
								<path fill-rule="evenodd" d="M12.416 5.376a.75.75 0 0 1 .083 1.06l-5 5.5a.75.75 0 0 1-1.126-.073l-2.5-3a.75.75 0 0 1 1.093-1.025l2.07 2.484 4.555-5.013a.75.75 0 0 1 1.063-.066Z" clip-rule="evenodd"/>
							</svg>
						</label>
					</li>
				}
				<li class="multiselect-empty" x-show="!hasMatches()">
					<span>No shows match "<span x-text="search"></span>"</span>
				</li>
			</ul>

			<div class="multiselect-footer">
				<button type="button" class="multiselect-link" @click="clearAll()">Clear all</button>
				<button type="button" class="multiselect-done" @click="open = false">Done</button>
			</div>
		</div>
	</div>
}

// dateFormat returns the human-readable string for an ISO yyyy-mm-dd
// value, using the runtime locale. Returns the empty string for unset
// input. Server-side fallback so the trigger label renders correctly
// before Alpine boots.
func dateFormat(value string) string {
	if value == "" {
		return ""
	}
	return value // The picker will display the locale-formatted value via Alpine at runtime.
}

// NativeDateInput renders a polished date pill on top of the browser's
// native <input type="date">. The native input stays in the form for
// full keyboard / a11y support but is offscreen-positioned. Alpine
// keeps the trigger label and value in sync and opens the picker on
// trigger click.
//
// Without Alpine the native <input> still works as a regular form
// field; the visible trigger simply doesn't appear.
templ NativeDateInput(name, id, label, value string) {
	<div class="date-input" x-data={ "{ value: '" + value + "', open: false, format(v) { if (!v) return ''; var d = new Date(v + 'T00:00:00'); if (isNaN(d.getTime())) return v; return new Intl.DateTimeFormat(undefined, { year: 'numeric', month: 'long', day: 'numeric' }).format(d); } }" }>
		<span class="date-input-label">{ label }</span>
		<button type="button" class="date-input-trigger"
			:class="{ 'is-empty': value === '', 'is-open': open }"
			@click="var el = $refs.picker; if (el && typeof el.showPicker === 'function') { el.showPicker(); } open = true;"
			@blur="open = false"
			aria-controls={ id }>
			<svg class="date-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
				<line x1="16" y1="2" x2="16" y2="6"/>
				<line x1="8" y1="2" x2="8" y2="6"/>
				<line x1="3" y1="10" x2="21" y2="10"/>
			</svg>
			<span class="date-input-display" x-text="format(value)"></span>
			<span class="date-input-empty-hint" x-show="value === ''">Select a date</span>
			if len(value) != 0 {
				<button type="button" class="date-input-clear"
					@click.prevent="value = ''; $refs.picker.value = ''; $dispatch('dateinput:change');"
					aria-label={ "Clear " + label }>×</button>
			}
		</button>
		<input type="date"
			id={ id }
			name={ name }
			class="date-input-native"
			title={ label }
			x-ref="picker"
			if len(value) != 0 {
				value={ value }
			}
			@change="value = $event.target.value; open = false;"
			@dateinput:change.window="value = ''; $refs.picker.value = '';"/>
	</div>
}

