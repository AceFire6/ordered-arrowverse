# Application
SERVICE_NAME=arrowverse-v2
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8080
SHUTDOWN_TIMEOUT=5s

# Database (matches compose.yaml defaults)
DATABASE_USER=arrowverse
DATABASE_PASSWORD=arrowverse
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@localhost:5432/arrowverse?sslmode=disable
DATABASE_LOG_LEVEL=warn

# Redis
REDIS_URL=redis://localhost:6379
REDIS_TIMEOUT=3s

# Site
SITE_TITLE="Arrowverse Episode Order"
SITE_HEADING="Arrowverse Episode Order"

# Legacy (Heroku) host and canonical URL promoted to visitors on the old URL
OLD_SITE_HOST=flash-arrow-order.herokuapp.com
NEW_SITE_URL=https://arrowverse.info

# Scraper / outbound HTTP user-agent (used when harvesting show data)
ADMIN_EMAIL=admin@example.com

# Demo mode: requests to hosts starting with this prefix are served the
# production content but flagged as demo for future middleware use.
DEMO_MODE_HOST_PREFIX=demo.

# CSRF (Echo's CSRF middleware uses per-request random tokens; no key
# required by default but listed here for documentation).

# Optional: enable the pprof debug listener by setting a bind address.
# Defaults to off so production deployments never expose it accidentally.
DEBUG_PPROF_ADDR=
DEBUG_PPROF_TIMEOUT=2s
